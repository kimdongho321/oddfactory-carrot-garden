<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
 <!-- 오래 안 쓴 앱(잡초)을 알려고 앱별 마지막 사용 시각만 읽는다 -->
 <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions"/>
 <!-- 앱 안 업데이트 확인(GitHub 최신 릴리스) -->
 <!-- '텃밭 배경화면' 버튼: 홈 화면 배경을 텃밭 그림으로(사용자가 확인 창에서 고를 때만) -->
 <uses-permission android:name="android.permission.SET_WALLPAPER"/>
 <!-- 텃밭에서 잡초(앱)를 뽑을 때 Android 삭제 확인 창을 띄운다(실제 삭제는 사용자가 확인) -->
 <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES"/>
 <uses-permission android:name="android.permission.INTERNET"/>
 <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
 <permission android:name="com.oddfactory.carrot.UPDATE_STATUS" android:protectionLevel="signature"/>
 <uses-permission android:name="com.oddfactory.carrot.UPDATE_STATUS"/>
 <!-- 홈 화면 아이콘 이름 → 앱을 맞추려고 실행 가능한 앱 목록만 조회 -->
 <queries>
  <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent>
  <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.HOME"/></intent>
 </queries>
 <application android:theme="@android:style/Theme.Material.Light.NoActionBar" android:label="@string/app_name"
   android:icon="@mipmap/of_box_launcher" android:roundIcon="@mipmap/of_box_launcher_round" android:allowBackup="false">
  <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
  </activity>
  <activity android:name=".GardenActivity" android:exported="true" android:label="캬롯 텃밭"
    android:theme="@android:style/Theme.Material.Light.NoActionBar"/>
  <service android:name=".CarrotService" android:exported="true" android:label="@string/app_name"
    android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
   <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
   <meta-data android:name="android.accessibilityservice" android:resource="@xml/carrot_a11y"/>
  </service>
 </application>
</manifest>
